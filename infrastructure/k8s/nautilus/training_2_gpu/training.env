TRAINER_REPLICAS=2

# Training overrides (mapped into container env; keep aligned with src/training/configs/training.yaml)
MODEL_NAME=gpt2
MODEL_MAX_LENGTH=32
LORA_TARGET_MODULES=q_proj,v_proj
TRAIN_BATCH_SIZE=1
TRAIN_NUM_EPOCHS=1
TRAIN_LR=5e-5
TRAIN_USE_LORA=false
TRAIN_MAX_STEPS=200
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
TORCH_NCCL_BLOCKING_WAIT=1
TORCH_NCCL_DEBUG=INFO
TORCH_NCCL_SOCKET_IFNAME=eth0