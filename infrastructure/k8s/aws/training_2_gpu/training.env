TRAINER_REPLICAS=2

# Training overrides (aligned with src/training/configs/training.yaml)
MODEL_NAME=gpt2
MODEL_MAX_LENGTH=32
LORA_TARGET_MODULES=q_proj,v_proj
TRAIN_BATCH_SIZE=16
TRAIN_NUM_EPOCHS=1
TRAIN_LR=5e-5
TRAIN_USE_LORA=false
TRAIN_MAX_STEPS=200

# AWS-specific
AWS_REGION=us-east-1
S3_DATA_PREFIX=s3://llm-training-outputs/data
S3_OUTPUT_PREFIX=s3://llm-training-outputs/outputs
