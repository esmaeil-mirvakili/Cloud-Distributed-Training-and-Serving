# GPU-enabled llama.cpp serving image using llama-cpp-python with GGML_CUDA.
FROM python:3.10-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LLAMA_MODEL_PATH=/models/model.gguf \
    LLAMA_CPP_REPO=https://github.com/ggerganov/llama.cpp.git \
    LLAMA_CPP_REF=master

ARG LLAMA_CPP_PY_VERSION=0.2.90

# Install CUDA toolkit 12.3.1 (includes nvcc) and build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    build-essential \
    cmake \
    git \
    curl \
    python3-dev \
    libcurl4 \
    libcurl4-openssl-dev \
    ninja-build && \
    wget https://developer.download.nvidia.com/compute/cuda/12.3.1/local_installers/cuda-repo-debian12-12-3-local_12.3.1-545.23.08-1_amd64.deb && \
    dpkg -i cuda-repo-debian12-12-3-local_12.3.1-545.23.08-1_amd64.deb && \
    cp /var/cuda-repo-debian12-12-3-local/cuda-*-keyring.gpg /usr/share/keyrings/ && \
    add-apt-repository contrib && \
    apt-get update && \
    apt-get -y install cuda-toolkit-12-3 && \
    rm -f cuda-repo-debian12-12-3-local_12.3.1-545.23.08-1_amd64.deb && \
    rm -rf /var/lib/apt/lists/*

# Python deps (GPU build of llama-cpp-python)
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir \
       fastapi \
       "uvicorn[standard]" \
       prometheus-client \
       httpx \
       psutil \
       nvidia-ml-py3

RUN CUDACXX=/usr/local/cuda/bin/nvcc CMAKE_ARGS="-DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=all-major" FORCE_CMAKE=1 \
    pip install --no-cache-dir --no-binary=llama-cpp-python \
    "git+https://github.com/abetlen/llama-cpp-python.git@v${LLAMA_CPP_PY_VERSION}"

# Optional: build llama-server GPU binary (not used directly by python backend, but handy)
WORKDIR /opt
RUN git clone --depth 1 --branch ${LLAMA_CPP_REF} ${LLAMA_CPP_REPO} llama.cpp && \
    cmake -S llama.cpp -B llama.cpp/build \
      -DLLAMA_BUILD_SERVER=ON -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_METAL=OFF -DLLAMA_ACCELERATE=OFF -DLLAMA_CURL=OFF -DGGML_CUDA=ON -DCMAKE_BUILD_TYPE=Release && \
    cmake --build llama.cpp/build --config Release --target llama-server -j "$(nproc)" && \
    ln -s /opt/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server

WORKDIR /app

COPY src /app/src
ENV PYTHONPATH=/app/src

COPY infrastructure/docker/entrypoint.serving.sh /app/entrypoint.serving.sh
RUN chmod +x /app/entrypoint.serving.sh

# Non-root user
RUN useradd -m llama && chown -R llama:llama /app
USER llama

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.serving.sh"]
