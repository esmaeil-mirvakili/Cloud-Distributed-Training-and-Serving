# Copy this file to `infrastructure/docker/llama.env` and update the values
# to point at your local GGUF model before running docker compose.

# Host path containing your model files (relative to this compose file by default).
LLAMA_MODEL_DIR=/models

# Huggingface model
LLAMA_MODEL=TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF

# Path to the model file inside the container (must live under /models).
LLAMA_MODEL_PATH=/models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf

# Runtime tuning knobs for llama.cpp.
LLAMA_THREADS=4
LLAMA_CONTEXT=512

# Host port bound by the NGINX load balancer.
NGINX_PORT=8000
