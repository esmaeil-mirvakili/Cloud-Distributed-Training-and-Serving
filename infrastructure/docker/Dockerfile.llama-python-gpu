# ---------------------------
# Build
# ---------------------------
FROM nvidia/cuda:12.3.1-devel-ubuntu22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    git \
    cmake \
    ninja-build \
    build-essential \
    curl \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Fix CUDA driver API link errors at build time: CUDA images don't ship libcuda.so.1 (it is provided by the host at runtime).
# Use the CUDA stub library for linking during build.
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LIBRARY_PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH}

# Build a wheel for llama-cpp-python (CUDA) so we can install it quickly in runtime.
# WORKDIR /wheelhouse
# RUN --mount=type=cache,target=/root/.cache/pip \
#     CUDACXX=/usr/local/cuda/bin/nvcc \
#     CMAKE_ARGS="-DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHS}" \
#     FORCE_CMAKE=1 \
#     pip wheel --no-binary=llama-cpp-python \
#       "llama-cpp-python==0.2.90"

# Optional: build llama-server GPU binary (handy for debugging / benchmarking)
RUN git clone --depth 1 --branch master https://github.com/ggerganov/llama.cpp.git /opt/llama.cpp
RUN cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
      -DLLAMA_BUILD_SERVER=ON \
      -DLLAMA_BUILD_EXAMPLES=OFF \
      -DLLAMA_METAL=OFF \
      -DLLAMA_ACCELERATE=OFF \
      -DLLAMA_CURL=OFF \
      -DGGML_CUDA=ON \
      -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs" \
      -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs" \
      -DCMAKE_CUDA_ARCHITECTURES=86 \
      -DCMAKE_BUILD_TYPE=Release \
  && cmake --build /opt/llama.cpp/build --config Release --target llama-server -j "$(nproc)"

# ---------------------------
# Runtime
# ---------------------------
FROM nvidia/cuda:12.3.1-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LLAMA_MODEL_PATH=/models/model.gguf

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    ca-certificates \
    libgomp1 \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip

# App deps (pure python / small)
RUN pip install --no-cache-dir \
       fastapi \
       "uvicorn[standard]" \
       prometheus-client \
       httpx \
       psutil \
       nvidia-ml-py3

# Install the CUDA-built llama-cpp-python wheel from the build stage
# COPY --from=build /wheelhouse/*.whl /tmp/
# RUN pip install --no-cache-dir /tmp/*.whl && rm -rf /tmp/*.whl

# Bring in llama-server binary
COPY --from=build /opt/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server

WORKDIR /app

COPY src /app/src
ENV PYTHONPATH=/app/src

COPY infrastructure/docker/entrypoint.serving.sh /app/entrypoint.serving.sh
RUN chmod +x /app/entrypoint.serving.sh

# Non-root user
RUN useradd -m llama && chown -R llama:llama /app
USER llama

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.serving.sh"]
